# Copy to .env and fill in. `make init` adds the generated secrets (tokens, encryption key, database password).
# Only what a team must decide is here; every other setting has a sensible default (docs/configuration.md).

# The agent and the model it uses. sandbox-gateway holds the key; sandboxes never see it.
SIS_DRY_RUN=false
SIS_AGENT=claude
INSTALL_CLAUDE=true
LLM_UPSTREAM_URL=https://api.anthropic.com
LLM_UPSTREAM_KEY=
MODEL_IMPLEMENTATION=claude-haiku-5-5  # must be a model the provider above serves

SIS_DRY_RUN=true                     # jira-connector only logs what it would do; set false to start work on tickets
SIS_MAX_BUDGET_USD=2.0               # spend cap per ticket; at the cap the agent asks on Jira
SIS_BUDGET_EXTENSION_USD=2.0         # added when a person replies "@sis approve", and per review round on an open PR

# Jira Cloud: shared account for teams without their own connection (teams add theirs on Admin → Connections)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub: a token for local use, or a GitHub App in production (takes precedence when set)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Before going live: services refuse to start with unsafe settings, and the dashboard needs sign-in (docs/security.md, "Running in production")
# SIS_ENV=production

# Company sign-in (optional locally, required before sharing the dashboard): see components/auth-proxy/README.md
# SIS_AUTH_MODE=proxy
# SIS_PORTAL_ADMINS=platform-admins
# SIS_PORTAL_OPERATORS=eng-leads
# SSO_ISSUER_URL= SSO_CLIENT_ID= SSO_CLIENT_SECRET= SSO_COOKIE_SECRET= SSO_EMAIL_DOMAINS=
